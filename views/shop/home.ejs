<%- include('../partials/shop_top') %>
<div class="d-flex justify-content-between align-items-center mb-3">
  <h3 class="mb-0"><%= heading %></h3>
  <span class="text-secondary"><%= products.length %> product(s)</span>
</div>
<% if (!products.length) { %>
  <div class="alert alert-secondary">No products found.</div>
<% } %>
<div class="row g-3">
  <% products.forEach(p => { %>
    <div class="col-6 col-md-4 col-lg-3">
      <div class="card h-100 shadow-sm product-card">
        <a href="/product/<%= p.id %>"><img src="<%= p.image || '/img/placeholder.svg' %>" class="card-img-top product-img" alt="<%= p.name %>"></a>
        <div class="card-body d-flex flex-column">
          <h6 class="card-title mb-1"><a href="/product/<%= p.id %>" class="text-decoration-none text-body"><%= p.name %></a></h6>
          <div class="text-secondary small mb-2">SKU: <%= p.sku %></div>
          <div class="price text-primary mt-auto"><%= fmt(p.price) %></div>
        </div>
        <div class="card-footer bg-transparent border-0 pt-0">
          <form method="post" action="/cart/add">
            <input type="hidden" name="product_id" value="<%= p.id %>">
            <button class="btn btn-primary btn-sm w-100"><i class="bi bi-cart-plus"></i> Add to cart</button>
          </form>
        </div>
      </div>
    </div>
  <% }) %>
</div>
<%- include('../partials/shop_bottom') %>
