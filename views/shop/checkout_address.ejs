<%- include('../partials/shop_top') %>
<div class="d-flex steps mb-4">
  <div class="step active">1. Shipping address</div>
  <div class="step">2. Payment &amp; review</div>
</div>
<div class="row g-3">
  <div class="col-lg-8">
    <div class="card shadow-sm">
      <div class="card-header"><h3 class="card-title">Shipping address</h3></div>
      <form method="post" action="/checkout/address">
        <div class="card-body">
          <div class="row g-3">
            <div class="col-md-6"><label class="form-label">Full name</label><input name="name" class="form-control" value="<%= a.name || '' %>" required></div>
            <div class="col-md-6"><label class="form-label">Phone</label><input name="phone" class="form-control" value="<%= a.phone || '' %>" required></div>
            <div class="col-12"><label class="form-label">Address</label><input name="address" class="form-control" value="<%= a.address || '' %>" required></div>
            <div class="col-md-6"><label class="form-label">City</label><input name="city" class="form-control" value="<%= a.city || '' %>" required></div>
          </div>
        </div>
        <div class="card-footer d-flex justify-content-between">
          <a href="/cart" class="btn btn-outline-secondary"><i class="bi bi-arrow-left"></i> Back to cart</a>
          <button class="btn btn-primary">Continue to payment <i class="bi bi-arrow-right"></i></button>
        </div>
      </form>
    </div>
  </div>
  <div class="col-lg-4">
    <div class="card shadow-sm">
      <div class="card-header"><h3 class="card-title">Your items</h3></div>
      <ul class="list-group list-group-flush">
        <% cart.items.forEach(it => { %>
          <li class="list-group-item d-flex justify-content-between"><span><%= it.name %><br><small class="text-secondary"><%= it.sku %></small></span><span><%= fmt(it.price) %></span></li>
        <% }) %>
      </ul>
    </div>
  </div>
</div>
<%- include('../partials/shop_bottom') %>
