<%- include('../partials/shop_top') %>
<div class="d-flex flex-column align-items-center justify-content-center text-center no-access">
  <i class="bi <%= icon %> text-secondary" style="font-size:4rem"></i>
  <h3 class="mt-3"><%= heading %></h3>
  <% if (text) { %><p class="text-secondary"><%= text %></p><% } %>
  <% if (typeof link !== 'undefined' && link) { %><a href="<%= link.href %>" class="btn btn-primary"><%= link.label %></a><% } else { %><a href="/" class="btn btn-outline-primary">Back to home</a><% } %>
</div>
<%- include('../partials/shop_bottom') %>
