<%- include('../partials/shop_top') %>
<h3 class="mb-3">Posts</h3>
<div class="list-group shadow-sm">
  <% if (!posts.length) { %><div class="list-group-item text-secondary">No posts.</div><% } %>
  <% posts.forEach(p => { %>
    <% if (p.canView) { %>
      <a href="/posts/<%= p.url %>" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center">
        <span><i class="bi bi-unlock text-success"></i> <%= p.title %></span>
        <% if (p.license_name) { %><span class="badge text-bg-info"><%= p.license_name %></span><% } else { %><span class="badge text-bg-light border">Public</span><% } %>
      </a>
    <% } else { %>
      <div class="list-group-item d-flex justify-content-between align-items-center text-secondary bg-body-tertiary"
           style="cursor:not-allowed" aria-disabled="true" title="You need the <%= p.license_name %> license to read this post">
        <span><i class="bi bi-lock-fill"></i> <%= p.title %></span>
        <span class="small">License required: <span class="badge text-bg-secondary"><%= p.license_name %></span></span>
      </div>
    <% } %>
  <% }) %>
</div>
<%- include('../partials/shop_bottom') %>
