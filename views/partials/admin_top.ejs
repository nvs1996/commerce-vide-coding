<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> | Commerce Admin</title>
  <link rel="icon" href="/img/logo.svg">
  <link rel="stylesheet" href="/vendor/bootstrap-icons/bootstrap-icons.min.css">
  <link rel="stylesheet" href="/vendor/adminlte/css/adminlte.min.css">
</head>
<body class="layout-fixed sidebar-expand-lg bg-body-tertiary">
<div class="app-wrapper">
  <nav class="app-header navbar navbar-expand bg-body">
    <div class="container-fluid">
      <ul class="navbar-nav">
        <li class="nav-item"><a class="nav-link" data-lte-toggle="sidebar" href="#" role="button"><i class="bi bi-list"></i></a></li>
        <li class="nav-item d-none d-md-block"><a href="/admin" class="nav-link">Home</a></li>
        <li class="nav-item d-none d-md-block"><a href="/" target="_blank" class="nav-link">View shop</a></li>
      </ul>
      <ul class="navbar-nav ms-auto">
        <li class="nav-item d-flex align-items-center me-3 text-secondary gap-2">
          <%- include('avatar', { c: { name: admin.username, avatar: admin.avatar }, size: 32 }) %><span><%= admin.username %></span>
        </li>
        <li class="nav-item">
          <form method="post" action="/admin/logout" class="m-0"><button class="btn btn-sm btn-outline-secondary">Logout</button></form>
        </li>
      </ul>
    </div>
  </nav>

  <aside class="app-sidebar bg-body-secondary shadow" data-bs-theme="dark">
    <div class="sidebar-brand">
      <a href="/admin" class="brand-link">
        <img src="/img/logo.svg" alt="logo" class="brand-image opacity-75 shadow">
        <span class="brand-text fw-light">Commerce Admin</span>
      </a>
    </div>
    <div class="sidebar-wrapper">
      <nav class="mt-2">
        <ul class="nav sidebar-menu flex-column" role="menu">
          <li class="nav-item">
            <a href="/admin" class="nav-link <%= active === 'dashboard' ? 'active' : '' %>"><i class="nav-icon bi bi-speedometer2"></i><p>Dashboard</p></a>
          </li>
          <% Object.entries(resources).forEach(([k, r]) => { %>
            <li class="nav-item">
              <a href="/admin/<%= k %>" class="nav-link <%= active === k ? 'active' : '' %>"><i class="nav-icon bi <%= r.icon %>"></i><p><%= r.label %></p></a>
            </li>
          <% }) %>
        </ul>
      </nav>
    </div>
  </aside>

  <main class="app-main">
    <div class="app-content-header">
      <div class="container-fluid">
        <div class="row"><div class="col-sm-6"><h3 class="mb-0"><%= title %></h3></div></div>
      </div>
    </div>
    <div class="app-content">
      <div class="container-fluid">
        <% if (flash) { %><div class="alert alert-<%= flash.type %> alert-dismissible"><%= flash.msg %><button type="button" class="btn-close" data-bs-dismiss="alert"></button></div><% } %>
